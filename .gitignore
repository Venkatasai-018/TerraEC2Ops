# Ignore Terraform state files
*.tfstate
*.tfstate.*

# Ignore Terraform working directory
.terraform/

# Ignore Terraform lock file (optional — include if you want reproducible builds)
.terraform.lock.hcl
Ec2Auto_StartStop_Schedular/.terraform.lock.hcl

# Ignore SSH keys (auto-generated or manually created)
**/keys/
**/keys/auto
**/keys/auto.*
*.pem
*.pub

# Ignore crash logs
crash.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan output
*.tfplan

# Ignore sensitive variable files
*.tfvars
*.tfvars.json